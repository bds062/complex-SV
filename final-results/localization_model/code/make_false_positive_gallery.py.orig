#!/usr/bin/env python3
"""Build a four-class top-false-positive genome-plot gallery for a model package."""
from __future__ import annotations
import shutil
import subprocess
import sys
from pathlib import Path
import numpy as np
import pandas as pd

PACKAGE=Path(__file__).resolve().parents[1]
WORKSPACE=PACKAGE.parents[1]
RESULTS=WORKSPACE/"results"
OUT=PACKAGE/"figures/false_positives"
MODEL=PACKAGE.name
CLASSES=["BFB","chromothripsis","ecDNA","seismic_amplification"]
HG38={"1":248956422,"2":242193529,"3":198295559,"4":190214555,"5":181538259,"6":170805979,
      "7":159345973,"8":145138636,"9":138394717,"10":133797422,"11":135086622,"12":133275309,
      "13":114364328,"14":107043718,"15":101991189,"16":90338345,"17":83257441,"18":80373285,
      "19":58617616,"20":64444167,"21":46709983,"22":50818468,"X":156040895,"Y":57227415}

def ckey(value): return str(value).strip().removeprefix("chr").removeprefix("CHR")
def overlap(a0,a1,b0,b1): return max(0,min(a1,b1)-max(a0,b0))/max(1,min(a1-a0,b1-b0))
def centromeres():
    d=pd.read_csv(RESULTS/"grch38.cen_coord.curated.bed",sep="\t",header=None,names=["chrom","start","end"])
    return {ckey(r.chrom):(int(r.start),int(r.end)) for r in d.itertuples()}

def maximum_match(pred,truth):
    """Maximum-cardinality same-class OC>=0.5 assignment, grouped by sample/chrom/class."""
    matched=set()
    for keys,calls in truth.groupby(["sample_id","chrom","label"],sort=False):
        possible=pred.copy()
        for col,value in zip(["sample_id","chrom","label"],keys): possible=possible[possible[col].astype(str)==str(value)]
        if possible.empty: continue
        possible=possible.sort_values("score",ascending=False).reset_index(drop=True)
        call_rows=list(calls.itertuples()); edges=[]
        for p in possible.itertuples():
            edges.append([j for j,c in enumerate(call_rows) if overlap(int(p.start),int(p.end)+1,int(c.start),int(c.end)+1)>=.5])
        owner=[-1]*len(call_rows)
        def augment(i,seen):
            for j in edges[i]:
                if seen[j]: continue
                seen[j]=True
                if owner[j]<0 or augment(owner[j],seen): owner[j]=i; return True
            return False
        for i in range(len(possible)): augment(i,[False]*len(call_rows))
        matched.update(int(possible.iloc[i]["_prediction_id"]) for i in owner if i>=0)
    return matched

def arm_context(chrom,start,end,cens):
    key=ckey(chrom); cen0,cen1=cens[key]; chrom_end=HG38[key]; midpoint=(start+end)/2
    if start<cen1 and end>cen0: return "",0,chrom_end
    if midpoint<cen0: return "p",0,cen0
    return "q",cen1,chrom_end

def localization_rows(top):
    cens=centromeres(); rows=[]
    truth=pd.read_csv(PACKAGE/"labels/all_labels.tsv",sep="\t")
    for r in top.itertuples(index=False):
        arm,ctx0,ctx1=arm_context(r.chrom,int(r.start),int(r.end),cens)
        same=truth[(truth.sample_id.astype(str)==str(r.sample_id))&(truth.chrom.astype(str)==str(r.chrom))]
        true_classes=";".join(sorted(same.label.astype(str).unique()))
        rows.append({"candidate_id":r.event_id,"sample_id":r.sample_id,"chrom":r.chrom,"arm":arm,
          "start_bp":ctx0,"end_bp":ctx1,"context_start_bp":ctx0,"context_end_bp":ctx1,
          "highlight_start_bp":max(ctx0,int(r.start)),"highlight_end_bp":min(ctx1,int(r.end)),
          "highlight_label":"Localization-model predicted interval","predicted_class":r.label,"predicted_classes":r.label,
          "called_complex_sv":True,"is_labeled":bool(true_classes),"sv_class":true_classes,"true_classes":true_classes,
          "evidence":"localized_event","split":"LOO","score":r.score,"objectness_prob":r.score,
          "score_text":f"LOO score={r.score:.3f}; class FP rank={r.class_fp_rank}; type={r.false_positive_type}; best same-class OC={r.best_same_class_overlap_coefficient:.3f}",
          "false_positive_type":r.false_positive_type,"fp_rank":r.class_fp_rank})
    return pd.DataFrame(rows)

def build_localization():
    pred=pd.read_csv(PACKAGE/"predictions/loo_predictions.tsv",sep="\t")
    pred["_prediction_id"]=np.arange(len(pred),dtype=int)
    truth=pd.read_csv(PACKAGE/"labels/all_labels.tsv",sep="\t")
    matched=maximum_match(pred,truth); pred["is_true_positive"]=pred["_prediction_id"].isin(matched)
    best=[]; fp_type=[]
    for r in pred.itertuples(index=False):
        calls=truth[(truth.sample_id.astype(str)==str(r.sample_id))&(truth.chrom.astype(str)==str(r.chrom))&(truth.label.astype(str)==str(r.label))]
        value=max([overlap(int(r.start),int(r.end)+1,int(c.start),int(c.end)+1) for c in calls.itertuples()] or [0.0]); best.append(value)
        fp_type.append("" if r.is_true_positive else ("duplicate" if value>=.5 else ("subthreshold geometry" if value>0 else "no same-class overlap")))
    pred["best_same_class_overlap_coefficient"]=best; pred["false_positive_type"]=fp_type
    fp=pred[~pred.is_true_positive].sort_values(["label","score"],ascending=[True,False]).copy()
    fp["class_fp_rank"]=fp.groupby("label").cumcount()+1
    top=fp.groupby("label",sort=False).head(10).copy()
    top.to_csv(OUT/"top_false_positives.tsv",sep="\t",index=False)
    return localization_rows(top),fp

def build_chromosome():
    pred=pd.read_csv(PACKAGE/"predictions/loo_oof_predictions.tsv",sep="\t")
    fp=pred[(pred.predicted==1)&(pred.truth==0)].copy(); fp["margin"]=fp.probability-fp.threshold
    all_truth=(pred[pred.truth==1].groupby(["sample_id","chrom"])["class"].agg(lambda x:";".join(sorted(set(x)))).rename("true_classes"))
    fp=fp.merge(all_truth,on=["sample_id","chrom"],how="left"); fp["true_classes"]=fp.true_classes.fillna("")
    fp=fp.sort_values(["class","margin"],ascending=[True,False]); fp["class_fp_rank"]=fp.groupby("class").cumcount()+1
    top=fp.groupby("class",sort=False).head(10).copy(); top.to_csv(OUT/"top_false_positives.tsv",sep="\t",index=False)
    meta=pd.read_csv(RESULTS/"pipeline27/chromosome_embeddings/candidate_embeddings.tsv",sep="\t")[["sample_id","chrom","start_bp","end_bp"]].drop_duplicates(["sample_id","chrom"])
    plot=top.merge(meta,on=["sample_id","chrom"],how="left")
    plot["context_start_bp"]=plot.start_bp; plot["context_end_bp"]=plot.end_bp
    plot["highlight_start_bp"]=plot.start_bp; plot["highlight_end_bp"]=plot.end_bp
    plot["highlight_label"]="Chromosome-model prediction"; plot["predicted_class"]=plot["class"]; plot["predicted_classes"]=plot["class"]
    plot["called_complex_sv"]=True; plot["is_labeled"]=plot.true_classes.ne(""); plot["sv_class"]=plot.true_classes
    plot["evidence"]="whole_chromosome"; plot["split"]="LOO"; plot["score"]=plot.probability; plot["objectness_prob"]=plot.probability
    plot["score_text"]=[f"P={r.probability:.3f}; threshold={r.threshold:.3f}; margin={r.margin:.3f}; class FP rank={r.class_fp_rank}; observed truth={r.true_classes or 'none'}" for r in plot.itertuples(index=False)]
    plot["false_positive_type"]=np.where(plot.true_classes.eq(""),"unlabeled chromosome","wrong class on labeled chromosome"); plot["fp_rank"]=plot.class_fp_rank
    return plot,fp

def prefix_ranked_plot_names(plot):
    """Prefix each generated PNG with its one-based within-class false-positive rank."""
    for r in plot.itertuples(index=False):
        region=f"{r.chrom}{r.arm}" if str(getattr(r,"arm","")).lower() in {"p","q"} else str(r.chrom)
        start=int(round(r.highlight_start_bp)); end=int(round(r.highlight_end_bp))
        pattern=f"{r.sample_id}_{region}_{r.predicted_class}_obj*_{start}_{end}.png"
        matches=[p for p in (OUT/str(r.predicted_class)).glob(pattern) if not p.name.split("_",1)[0].isdigit()]
        if len(matches) != 1:
            raise RuntimeError(f"Expected one unranked plot for rank {r.fp_rank}: {pattern}; found {matches}")
        source=matches[0]
        source.rename(source.with_name(f"{int(r.fp_rank)}_{source.name}"))

def main():
    if OUT.exists(): shutil.rmtree(OUT)
    OUT.mkdir(parents=True)
    plot,fp=build_localization() if MODEL=="localization_model" else build_chromosome()
    plot_path=OUT/"plot_input.tsv"; plot.to_csv(plot_path,sep="\t",index=False)
    subprocess.run([sys.executable,str(WORKSPACE/"complex-SV/discovery/plot_predicted_chromosomes.py"),
      "--manifest",str(RESULTS/"pipeline18/complex_sv_manifest.tsv"),"--prototype_distances",str(plot_path),
      "--output_dir",str(OUT),"--plot_scope","all","--group_by_column","predicted_class","--dpi","160",
      "--centromeres",str(RESULTS/"grch38.cen_coord.curated.bed")],check=True)
    counts=plot.groupby("predicted_class").size().reindex(CLASSES,fill_value=0)
    available=fp.groupby("label" if MODEL=="localization_model" else "class").size().reindex(CLASSES,fill_value=0)
    lines=["# Top LOO false positives","",f"Model: `{MODEL}`","","| Class | Plotted | Total available false positives |","|---|---:|---:|"]
    for cls in CLASSES: lines.append(f"| {cls} | {int(counts[cls])} | {int(available[cls])} |")
    lines += ["", "Plots are ranked by held-out score for localization and by probability-minus-threshold margin for chromosome classification."]
    if mode == "localization":
        lines += ["Localization false positives use strict same-class, one-to-one matching at overlap coefficient >= 0.5. Seismic amplification has only four such false positives, so all four are shown."]
    else:
        lines += ["Chromosome-model entries are observed-label false positives; incomplete labels may make some genuine events appear false positive."]
    (OUT/"README.md").write_text("\n".join(lines)+"\n")
    print(pd.DataFrame({"plotted":counts,"available":available}).to_string())
if __name__=="__main__": main()
