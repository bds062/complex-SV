#!/usr/bin/env python3
"""Cluster exact method-region embeddings and audit biological confounders."""

from __future__ import annotations

import argparse
import json
from pathlib import Path

import matplotlib

matplotlib.use("Agg")
import matplotlib.pyplot as plt  # noqa: E402
import numpy as np
import pandas as pd
from scipy.optimize import linear_sum_assignment
from sklearn.cluster import AgglomerativeClustering, KMeans
from sklearn.decomposition import PCA
from sklearn.metrics import (
    adjusted_rand_score,
    completeness_score,
    homogeneity_score,
    normalized_mutual_info_score,
    silhouette_score,
    v_measure_score,
)
from sklearn.mixture import GaussianMixture
from sklearn.neighbors import NearestNeighbors
from sklearn.preprocessing import StandardScaler


CLASS_ORDER = ["BFB", "chromothripsis", "ecDNA"]
CLASS_COLORS = {"BFB": "#E15759", "chromothripsis": "#4E79A7", "ecDNA": "#59A14F"}
CLUSTER_COLORS = ["#76B7B2", "#F28E2B", "#B07AA1", "#EDC948", "#FF9DA7"]


def preprocess(values: np.ndarray) -> np.ndarray:
    values = np.nan_to_num(np.asarray(values, dtype=np.float64), nan=0.0, posinf=0.0, neginf=0.0)
    scaled = StandardScaler().fit_transform(values)
    max_components = min(50, scaled.shape[0] - 1, scaled.shape[1])
    if max_components >= 2 and scaled.shape[1] > max_components:
        scaled = PCA(n_components=max_components, random_state=42).fit_transform(scaled)
    return np.asarray(scaled, dtype=np.float64)


def purity_score(labels: np.ndarray, clusters: np.ndarray) -> float:
    table = pd.crosstab(pd.Series(clusters), pd.Series(labels))
    return float(table.max(axis=1).sum() / max(1, table.to_numpy().sum()))


def mapped_accuracy(labels: np.ndarray, clusters: np.ndarray) -> tuple[float, dict[int, str]]:
    classes = sorted(pd.unique(labels).tolist())
    cluster_ids = sorted(pd.unique(clusters).tolist())
    table = pd.crosstab(pd.Series(clusters), pd.Series(labels)).reindex(index=cluster_ids, columns=classes, fill_value=0)
    row_idx, col_idx = linear_sum_assignment(-table.to_numpy())
    mapping = {int(cluster_ids[r]): str(classes[c]) for r, c in zip(row_idx, col_idx)}
    correct = sum(mapping.get(int(cluster)) == str(label) for cluster, label in zip(clusters, labels))
    return float(correct / max(1, len(labels))), mapping


def cluster_metrics(space: str, algorithm: str, x: np.ndarray, labels: np.ndarray, clusters: np.ndarray) -> dict[str, object]:
    accuracy, mapping = mapped_accuracy(labels, clusters)
    return {
        "feature_space": space,
        "algorithm": algorithm,
        "n_points": int(len(labels)),
        "n_clusters": int(len(np.unique(clusters))),
        "adjusted_rand_index": float(adjusted_rand_score(labels, clusters)),
        "normalized_mutual_information": float(normalized_mutual_info_score(labels, clusters)),
        "homogeneity": float(homogeneity_score(labels, clusters)),
        "completeness": float(completeness_score(labels, clusters)),
        "v_measure": float(v_measure_score(labels, clusters)),
        "cluster_purity": purity_score(labels, clusters),
        "hungarian_mapped_accuracy": accuracy,
        "cluster_silhouette": float(silhouette_score(x, clusters)) if len(np.unique(clusters)) > 1 else float("nan"),
        "true_label_silhouette": float(silhouette_score(x, labels)) if len(np.unique(labels)) > 1 else float("nan"),
        "cluster_to_class_mapping": json.dumps(mapping, sort_keys=True),
    }


def quantile_bins(values: pd.Series, bins: int = 4) -> pd.Series:
    numeric = pd.to_numeric(values, errors="coerce")
    if numeric.nunique(dropna=True) < 2:
        return pd.Series(["constant"] * len(values), index=values.index)
    ranked = numeric.rank(method="first")
    return pd.qcut(ranked, q=min(bins, int(numeric.notna().sum())), duplicates="drop").astype(str)


def eta_squared(values: pd.Series, groups: pd.Series) -> float:
    x = pd.to_numeric(values, errors="coerce").to_numpy(float)
    g = groups.astype(str).to_numpy()
    keep = np.isfinite(x)
    x, g = x[keep], g[keep]
    if not len(x) or np.var(x) == 0:
        return 0.0
    grand = float(np.mean(x))
    between = sum(len(x[g == group]) * (float(np.mean(x[g == group])) - grand) ** 2 for group in np.unique(g))
    total = float(np.sum((x - grand) ** 2))
    return float(between / total) if total else 0.0


def save_figure(fig: plt.Figure, output_dir: Path, stem: str) -> None:
    fig.savefig(output_dir / f"{stem}.png", dpi=300, bbox_inches="tight")
    fig.savefig(output_dir / f"{stem}.pdf", bbox_inches="tight")
    plt.close(fig)


def scatter_categorical(ax: plt.Axes, xy: np.ndarray, values: pd.Series, title: str, colors: dict[str, str] | None = None, max_categories: int = 12) -> None:
    text = values.astype(str)
    counts = text.value_counts()
    keep = counts.head(max_categories).index.tolist()
    shown = text.where(text.isin(keep), "Other")
    categories = keep + (["Other"] if bool(shown.eq("Other").any()) else [])
    palette = plt.get_cmap("tab20")
    for index, category in enumerate(categories):
        mask = shown.eq(category).to_numpy()
        color = colors.get(category) if colors and category in colors else ("#BDBDBD" if category == "Other" else palette(index % 20))
        ax.scatter(xy[mask, 0], xy[mask, 1], s=15, alpha=0.78, color=color, label=category, linewidths=0)
    ax.set_title(title, fontsize=13)
    ax.set_xticks([])
    ax.set_yticks([])
    ax.legend(frameon=False, fontsize=7, markerscale=1.3, loc="best")


def scatter_continuous(ax: plt.Axes, xy: np.ndarray, values: pd.Series, title: str, log1p: bool = False) -> None:
    numeric = pd.to_numeric(values, errors="coerce").fillna(0).to_numpy(float)
    display = np.log1p(np.clip(numeric, 0, None)) if log1p else numeric
    points = ax.scatter(xy[:, 0], xy[:, 1], c=display, cmap="viridis", s=16, alpha=0.82, linewidths=0)
    ax.set_title(title, fontsize=13)
    ax.set_xticks([])
    ax.set_yticks([])
    plt.colorbar(points, ax=ax, fraction=0.046, pad=0.03)


def umap_projection(x: np.ndarray) -> np.ndarray:
    import umap

    return np.asarray(
        umap.UMAP(n_components=2, n_neighbors=20, min_dist=0.15, metric="euclidean", random_state=42).fit_transform(x),
        dtype=np.float32,
    )


def plot_projection_facets(metadata: pd.DataFrame, xy: np.ndarray, output_dir: Path, prefix: str) -> None:
    fig, axes = plt.subplots(2, 2, figsize=(13, 10))
    scatter_categorical(axes[0, 0], xy, metadata["label"], "Method class", CLASS_COLORS, 3)
    cluster_colors = {str(i): CLUSTER_COLORS[i % len(CLUSTER_COLORS)] for i in sorted(metadata["cluster_k3"].unique())}
    scatter_categorical(axes[0, 1], xy, metadata["cluster_k3"].astype(str), "K-means cluster (k=3)", cluster_colors, 5)
    scatter_categorical(axes[1, 0], xy, metadata["sample_id"], "Sample ID (top 12)", None, 12)
    scatter_categorical(axes[1, 1], xy, metadata["chrom"], "Chromosome (top 12)", None, 12)
    fig.suptitle(f"Exact method regions: {prefix.replace('_', ' ')}", fontsize=16)
    fig.tight_layout()
    save_figure(fig, output_dir, f"{prefix}_umap_categorical_facets")

    fig, axes = plt.subplots(2, 3, figsize=(16, 10))
    continuous = [
        ("interval_length", "Interval length (log1p)", True),
        ("n_segments", "CN segments (log1p)", True),
        ("n_breakpoints", "SV breakpoints (log1p)", True),
        ("n_FB", "Foldbacks (log1p)", True),
        ("ploidy", "Regional ploidy", False),
        ("sample_ploidy", "Sample ploidy", False),
    ]
    for ax, (column, title, use_log) in zip(axes.flat, continuous):
        scatter_continuous(ax, xy, metadata[column], title, use_log)
    fig.suptitle(f"Potential confounders: {prefix.replace('_', ' ')}", fontsize=16)
    fig.tight_layout()
    save_figure(fig, output_dir, f"{prefix}_umap_continuous_facets")


def plot_class_distributions(metadata: pd.DataFrame, output_dir: Path) -> None:
    features = [
        ("interval_length", "Interval length (Mb)", 1e6, True),
        ("n_segments", "CN segments", 1.0, True),
        ("n_breakpoints", "SV breakpoints", 1.0, True),
        ("n_FB", "Foldbacks", 1.0, True),
        ("ploidy", "Regional ploidy", 1.0, False),
        ("sample_ploidy", "Sample ploidy", 1.0, False),
    ]
    fig, axes = plt.subplots(2, 3, figsize=(16, 9))
    for ax, (column, title, scale, log_axis) in zip(axes.flat, features):
        data = [pd.to_numeric(metadata.loc[metadata["label"].eq(label), column], errors="coerce").dropna().to_numpy() / scale for label in CLASS_ORDER]
        boxes = ax.boxplot(data, tick_labels=CLASS_ORDER, patch_artist=True, showfliers=False)
        for patch, label in zip(boxes["boxes"], CLASS_ORDER):
            patch.set_facecolor(CLASS_COLORS[label])
            patch.set_alpha(0.72)
        if log_axis:
            ax.set_yscale("symlog", linthresh=1.0)
        ax.set_title(title, fontsize=12)
        ax.tick_params(axis="x", rotation=20)
        ax.spines[["top", "right"]].set_visible(False)
        ax.grid(axis="y", color="#DDDDDD", linewidth=0.7)
    fig.suptitle("Caller-label feature distributions", fontsize=16)
    fig.tight_layout()
    save_figure(fig, output_dir, "class_feature_distributions")


def run(args: argparse.Namespace) -> None:
    embedding_dir = Path(args.embedding_dir)
    output_dir = Path(args.output_dir)
    output_dir.mkdir(parents=True, exist_ok=True)
    metadata = pd.read_csv(embedding_dir / "candidate_embeddings.tsv", sep="\t").fillna("")
    regions = pd.read_csv(args.method_regions).fillna("")
    region_columns = [column for column in regions.columns if column not in metadata.columns or column in {"candidate_id", "label", "source", "source_call_id", "source_region"}]
    metadata = metadata.merge(regions[region_columns], on="candidate_id", how="left", validate="one_to_one")
    embeddings = np.asarray(np.load(embedding_dir / "selected_embedding_features.npz", allow_pickle=True)["embeddings"], dtype=np.float32)
    tabular = np.asarray(np.load(embedding_dir / "tabular_features.npz", allow_pickle=True)["features"], dtype=np.float32)
    if len(metadata) != len(embeddings):
        raise ValueError("Embedding and metadata row counts differ")

    local_dim = int(pd.to_numeric(metadata["local_embedding_dim"], errors="coerce").mode().iloc[0])
    context_dim = int(pd.to_numeric(metadata["context_embedding_dim"], errors="coerce").mode().iloc[0])
    coord_dim = int(pd.to_numeric(metadata["coordinate_feature_dim"], errors="coerce").mode().iloc[0])
    diff_start = local_dim + context_dim
    coord_start = embeddings.shape[1] - coord_dim
    spaces = {
        "full_embedding": embeddings,
        "encoder_no_coordinates": embeddings[:, :coord_start],
        "local_encoder": embeddings[:, :local_dim],
        "context_encoder": embeddings[:, local_dim:diff_start],
        "local_context_difference": embeddings[:, diff_start:coord_start],
        "coordinates_only": embeddings[:, coord_start:],
        "tabular_only": tabular,
    }
    labels = metadata["label"].astype(str).to_numpy()
    metadata["interval_length"] = pd.to_numeric(metadata["end_bp"], errors="coerce") - pd.to_numeric(metadata["start_bp"], errors="coerce") + 1
    for column in ["interval_length", "n_segments", "n_breakpoints", "n_FB", "ploidy", "sample_ploidy"]:
        metadata[column] = pd.to_numeric(metadata[column], errors="coerce")


    metric_rows: list[dict[str, object]] = []
    k_rows: list[dict[str, object]] = []
    processed: dict[str, np.ndarray] = {}
    cluster_assignments: dict[str, np.ndarray] = {}
    for space_name, values in spaces.items():
        x = preprocess(values)
        processed[space_name] = x
        algorithms = {
            "kmeans_k3": KMeans(n_clusters=3, n_init=50, random_state=42).fit_predict(x),
            "agglomerative_k3": AgglomerativeClustering(n_clusters=3, linkage="ward").fit_predict(x),
            "gaussian_mixture_k3": GaussianMixture(n_components=3, covariance_type="diag", n_init=10, random_state=42).fit_predict(x),
        }
        for algorithm, clusters in algorithms.items():
            metric_rows.append(cluster_metrics(space_name, algorithm, x, labels, clusters))
        cluster_assignments[space_name] = algorithms["kmeans_k3"]
        for k in range(2, 11):
            clusters = KMeans(n_clusters=k, n_init=30, random_state=42).fit_predict(x)
            k_rows.append(
                {
                    "feature_space": space_name,
                    "k": k,
                    "silhouette": float(silhouette_score(x, clusters)),
                    "class_nmi": float(normalized_mutual_info_score(labels, clusters)),
                    "class_ari": float(adjusted_rand_score(labels, clusters)),
                    "purity": purity_score(labels, clusters),
                }
            )

    metrics = pd.DataFrame(metric_rows)
    metrics.to_csv(output_dir / "clustering_metrics.tsv", sep="\t", index=False)
    k_sweep = pd.DataFrame(k_rows)
    k_sweep.to_csv(output_dir / "kmeans_k_sweep.tsv", sep="\t", index=False)
    metadata["cluster_k3"] = cluster_assignments["full_embedding"].astype(int)

    confounders: list[dict[str, object]] = []
    categorical = {
        "true_method_class": metadata["label"].astype(str),
        "sample_id": metadata["sample_id"].astype(str),
        "chromosome": metadata["chrom"].astype(str),
        "interval_length_quartile": quantile_bins(metadata["interval_length"]),
        "regional_segments_quartile": quantile_bins(metadata["n_segments"]),
        "breakpoint_quartile": quantile_bins(metadata["n_breakpoints"]),
        "foldback_quartile": quantile_bins(metadata["n_FB"]),
        "regional_ploidy_quartile": quantile_bins(metadata["ploidy"]),
        "sample_ploidy_quartile": quantile_bins(metadata["sample_ploidy"]),
    }
    for space_name, clusters in cluster_assignments.items():
        for facet, values in categorical.items():
            clean_values = values.astype(object).where(pd.notna(values), "missing").astype(str).to_numpy()
            confounders.append(
                {
                    "feature_space": space_name,
                    "facet": facet,
                    "facet_type": "categorical",
                    "n_categories": int(values.nunique()),
                    "association": "normalized_mutual_information",
                    "value": float(normalized_mutual_info_score(clean_values, clusters)),
                }
            )
        for facet in ["interval_length", "n_segments", "n_breakpoints", "n_FB", "ploidy", "sample_ploidy"]:
            confounders.append(
                {
                    "feature_space": space_name,
                    "facet": facet,
                    "facet_type": "continuous",
                    "n_categories": 0,
                    "association": "eta_squared_by_cluster",
                    "value": eta_squared(metadata[facet], pd.Series(clusters)),
                }
            )
    pd.DataFrame(confounders).to_csv(output_dir / "cluster_confounder_associations.tsv", sep="\t", index=False)

    neighbor_rows: list[dict[str, object]] = []
    for space_name, x in processed.items():
        neighbors = NearestNeighbors(n_neighbors=2, metric="euclidean").fit(x).kneighbors(x, return_distance=False)[:, 1]
        distance = np.linalg.norm(x[:, None, :] - x[None, :, :], axis=2)
        np.fill_diagonal(distance, np.inf)
        same_sample = metadata["sample_id"].astype(str).to_numpy()[:, None] == metadata["sample_id"].astype(str).to_numpy()[None, :]
        cross_sample_distance = distance.copy()
        cross_sample_distance[same_sample] = np.inf
        cross_sample_neighbor = np.argmin(cross_sample_distance, axis=1)
        for scope, indices in (("nearest_any_sample", neighbors), ("nearest_different_sample", cross_sample_neighbor)):
            neighbor_rows.append(
                {
                    "feature_space": space_name,
                    "neighbor_scope": scope,
                    "same_class_fraction": float(np.mean(labels == labels[indices])),
                    "same_sample_fraction": float(np.mean(metadata["sample_id"].astype(str).to_numpy() == metadata["sample_id"].astype(str).to_numpy()[indices])),
                    "same_chromosome_fraction": float(np.mean(metadata["chrom"].astype(str).to_numpy() == metadata["chrom"].astype(str).to_numpy()[indices])),
                }
            )
    pd.DataFrame(neighbor_rows).to_csv(output_dir / "nearest_neighbor_diagnostics.tsv", sep="\t", index=False)

    for space_name in ("full_embedding", "encoder_no_coordinates"):
        xy = umap_projection(processed[space_name])
        pd.DataFrame({"candidate_id": metadata["candidate_id"], "umap_1": xy[:, 0], "umap_2": xy[:, 1]}).to_csv(
            output_dir / f"{space_name}_umap_coordinates.tsv", sep="\t", index=False
        )
        projection_metadata = metadata.copy()
        projection_metadata["cluster_k3"] = cluster_assignments[space_name]
        plot_projection_facets(projection_metadata, xy, output_dir, space_name)

        pca_xy = PCA(n_components=2, random_state=42).fit_transform(processed[space_name])
        fig, axes = plt.subplots(1, 2, figsize=(13, 5.5))
        scatter_categorical(axes[0], pca_xy, metadata["label"], "Method class", CLASS_COLORS, 3)
        cluster_colors = {str(i): CLUSTER_COLORS[i % len(CLUSTER_COLORS)] for i in sorted(np.unique(cluster_assignments[space_name]))}
        scatter_categorical(axes[1], pca_xy, pd.Series(cluster_assignments[space_name]).astype(str), "K-means cluster (k=3)", cluster_colors, 5)
        fig.suptitle(f"PCA diagnostic: {space_name.replace('_', ' ')}", fontsize=16)
        fig.tight_layout()
        save_figure(fig, output_dir, f"{space_name}_pca_class_and_cluster")

    plot_class_distributions(metadata, output_dir)

    primary = metrics[(metrics["feature_space"] == "full_embedding") & (metrics["algorithm"] == "kmeans_k3")].iloc[0]
    metadata.to_csv(output_dir / "method_regions_with_clusters.tsv", sep="\t", index=False)
    class_summary = metadata.groupby("label").agg(
        n_regions=("candidate_id", "size"),
        n_samples=("sample_id", "nunique"),
        interval_length_median=("interval_length", "median"),
        n_segments_median=("n_segments", "median"),
        n_breakpoints_median=("n_breakpoints", "median"),
        n_foldbacks_median=("n_FB", "median"),
        regional_ploidy_median=("ploidy", "median"),
    ).reset_index()
    class_summary.to_csv(output_dir / "class_feature_summary.tsv", sep="\t", index=False)

    summary = {
        "analysis_unit": "exact external-caller intervals; no generated candidate sets",
        "n_regions": int(len(metadata)),
        "n_samples": int(metadata["sample_id"].nunique()),
        "class_counts": {str(k): int(v) for k, v in metadata["label"].value_counts().items()},
        "embedding_dimensions": {name: int(values.shape[1]) for name, values in spaces.items()},
        "primary_clustering": {key: primary[key] for key in ["adjusted_rand_index", "normalized_mutual_information", "homogeneity", "completeness", "v_measure", "cluster_purity", "hungarian_mapped_accuracy", "cluster_silhouette", "true_label_silhouette", "cluster_to_class_mapping"]},
        "important_limitation": "Each biological class is supplied by exactly one caller, so caller-specific coordinate conventions cannot be separated from class biology in this corpus.",
    }
    (output_dir / "unsupervised_summary.json").write_text(json.dumps(summary, indent=2, default=float) + "\n")
    print(json.dumps(summary, indent=2, default=float))


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--embedding_dir", type=Path, required=True)
    parser.add_argument("--method_regions", type=Path, required=True)
    parser.add_argument("--output_dir", type=Path, required=True)
    return parser.parse_args()


if __name__ == "__main__":
    run(parse_args())
