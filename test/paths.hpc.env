#!/usr/bin/env bash
# Default single-genome integration-test paths on the Kolmogorov Lab HPC.
# Copy this file and replace any value to run against another installation.

export SAMPLE_ID="${SAMPLE_ID:-AU565}"
export WAKHAN_ROOT="${WAKHAN_ROOT:-/data/KolmogorovLab/HPV_Dean_Collab/nano_nf_runs/AU565/sv_cna_v2/wakhan/3.87_0.86_0.95/bed_output/AU565_3.87_0.86_0.95}"
export SEVERUS_VCF="${SEVERUS_VCF:-/data/KolmogorovLab/HPV_Dean_Collab/nano_nf_runs/AU565/sv_cna_v2/severus/somatic_SVs/severus_somatic.vcf}"
export LABEL_SOURCE_DIR="${LABEL_SOURCE_DIR:-/data/KolmogorovLab/srinivasanbd/final_labels}"
export TEST_OUTPUT_DIR="${TEST_OUTPUT_DIR:-/data/KolmogorovLab/srinivasanbd/results/complex_sv_release_test}"
export TEST_DEVICE="${TEST_DEVICE:-cpu}"
export TEST_PROFILE="${TEST_PROFILE:-balanced}"
export TEST_MAX_CANDIDATES="${TEST_MAX_CANDIDATES:-25}"
